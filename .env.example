# Copy this file to .env for local development. Never put real credentials here.
KNOWFLOW_ENVIRONMENT=local
KNOWFLOW_RUNTIME_ROLE=api
KNOWFLOW_DEBUG=false

# Deterministic modes are the safe defaults for tests and the local demo.
KNOWFLOW_MODEL_MODE=stub
KNOWFLOW_MODEL_BASE_URL=https://api.deepseek.com
KNOWFLOW_MODEL_API_KEY=
KNOWFLOW_MODEL_NAME=deepseek-chat
KNOWFLOW_MODEL_TIMEOUT_SECONDS=20
KNOWFLOW_OPERATIONS_SANDBOX_ENABLED=true
KNOWFLOW_NOTIFICATION_SANDBOX_ENABLED=true
KNOWFLOW_TELEMETRY_EXPORT_ENABLED=false

# Authentication. Replace local placeholders in .env before any shared deployment.
KNOWFLOW_JWT_SECRET=replace-with-at-least-32-random-characters
KNOWFLOW_JWT_ISSUER=knowflow-local
KNOWFLOW_JWT_AUDIENCE=knowflow-api
KNOWFLOW_JWT_TTL_SECONDS=900

# MySQL 8.4 (authoritative business state).
MYSQL_IMAGE_TAG=8.4
MYSQL_DATABASE=knowflow
MYSQL_USER=knowflow
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_PORT=3306
KNOWFLOW_DATABASE_URL=mysql+asyncmy://knowflow:change-me-local-only@127.0.0.1:3306/knowflow?charset=utf8mb4
KNOWFLOW_DATABASE_POOL_SIZE=10
KNOWFLOW_DATABASE_MAX_OVERFLOW=10

# Redis 8 (checkpoints, sessions, leases, rate limits, and cache only).
REDIS_IMAGE_TAG=8.0-alpine
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379
KNOWFLOW_REDIS_URL=redis://:change-me-local-only@127.0.0.1:6379/0
KNOWFLOW_REDIS_KEY_PREFIX=knowflow:local

# Milvus standalone and its etcd/MinIO dependencies.
ETCD_IMAGE_TAG=v3.5.18
MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-local-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_IMAGE_TAG=v2.5.27
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
KNOWFLOW_MILVUS_URI=http://127.0.0.1:19530
KNOWFLOW_MILVUS_COLLECTION=knowflow_segments_v1

# RocketMQ 5.5 broker and gRPC proxy.
ROCKETMQ_IMAGE_TAG=5.5.0
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_PROXY_REMOTING_PORT=8080
ROCKETMQ_PROXY_GRPC_PORT=8081
KNOWFLOW_ROCKETMQ_ENDPOINTS=127.0.0.1:8081
KNOWFLOW_ROCKETMQ_NAMESPACE=knowflow-local
KNOWFLOW_ROCKETMQ_CONSUMER_GROUP=knowflow-workers

# Captured local email delivery.
MAILPIT_IMAGE_TAG=v1.27
MAILPIT_MAX_MESSAGES=500
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KNOWFLOW_MAILPIT_SMTP_HOST=127.0.0.1
KNOWFLOW_MAILPIT_SMTP_PORT=1025

# Bounded execution, parsing, retrieval, and concurrency defaults.
KNOWFLOW_DEFAULT_INTERACTION_DEADLINE_SECONDS=15
KNOWFLOW_MAX_REQUEST_CONCURRENCY=20
KNOWFLOW_MAX_MODEL_CONCURRENCY=4
KNOWFLOW_MAX_DOCUMENT_BYTES=10485760
KNOWFLOW_MAX_PDF_PAGES=200
KNOWFLOW_MAX_DOCUMENT_CHARS=1000000
KNOWFLOW_RETRIEVAL_TOP_K=8
KNOWFLOW_TOOL_MAX_OUTPUT_BYTES=65536
KNOWFLOW_SANDBOX_ALLOWED_HOSTS=127.0.0.1,localhost
KNOWFLOW_SANDBOX_ALLOWED_COMMANDS=echo,python --version,docker version

# Optional observability. Leave disabled unless all local values are configured.
KNOWFLOW_OTEL_SERVICE_NAME=knowflow
KNOWFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=
KNOWFLOW_LANGFUSE_HOST=
KNOWFLOW_LANGFUSE_PUBLIC_KEY=
KNOWFLOW_LANGFUSE_SECRET_KEY=
